# =============================================================================
#  Пресет: python trader.py --env-file flow.env
# =============================================================================
#  ТОРГОВЫХ ПОРОГОВ ЗДЕСЬ НЕТ. Прежняя стратегия удалена целиком, вместе со
#  всеми её настройками. Осталась только инфраструктура.
#
#  Когда новая стратегия появится, её параметры добавляются сюда ВМЕСТЕ с
#  кодом, который их читает, — иначе файл снова зарастёт ключами, которые
#  никто не использует и которые молча ничего не делают.
#
#  ВАЖНО: этот файл в .gitignore (*.env) — ключ отсюда в git не уедет.
#  На VPS поставь ему chmod 600.
# =============================================================================

# --- режим -------------------------------------------------------------------
# true  = симуляция, ордера не отправляются (начинай ОТСЮДА)
# false = РЕАЛЬНЫЕ деньги; тогда обязательны PRIVATE_KEY и FUNDER ниже
DRY_RUN=true
ASSET=btc
DRY_RUN_BALANCE=100

# --- креды (только для DRY_RUN=false) ---------------------------------------
# Приватный ключ кошелька, с которого торгуем. НИКОМУ не показывай.
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- размер и лимиты ордера --------------------------------------------------
# Размер входа по умолчанию. Стратегия может запросить свой в Action.size_usdc.
FLOW_STAKE_USDC=1.0
# Минимум площадки. Размер округляется ВВЕРХ до него: округление вниз
# опускало каждый ордер под доллар ($1.00/0.53 = 1.8867 -> 1.88 -> $0.9964),
# и площадка его отвергала.
FLOW_MIN_ORDER_USDC=1.0
# Потолок ВСЕХ вложений в один раунд — ограничение риска, а не правило
# стратегии: сколько бы сделок она ни захотела, больше этого за окно не уйдёт.
FLOW_MAX_ROUND_USDC=25
# Пол цены продажи. ВЫКЛЮЧЕН (0), и это осознанно: пол противоречит смыслу
# стопа — выходить надо именно на падении, а он запрещает продавать ровно
# тогда, когда падает сильнее всего.
FLOW_MAX_SELL_SLIP=0

# --- задержки и таймауты -----------------------------------------------------
# Замерь на самом VPS или задай ориентир. Стокгольм -> Polymarket ~110-120мс.
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90
FLOW_ORDER_PROCESS_MS=45
FLOW_SIMULATE_LATENCY=true   # в dry-run честно ждать пинг перед филлом
# Сколько ждать ответа биржи. У клиента своего таймаута НЕТ, и повисший
# запрос оставлял флаг «ордер в полёте» взведённым навсегда: бот молча
# переставал торговать, продолжая печатать строки состояния.
FLOW_ORDER_TIMEOUT_S=10
# Пауза после ОТКАЗА биржи. Придерживает только ПОКУПКИ — продажу
# откладывать нельзя никогда.
FLOW_ERROR_COOLDOWN_S=5
# Сколько отказов продажи подряд терпеть, прежде чем снять позицию с торговли.
FLOW_MAX_SELL_FAILS=5

# --- сверка с биржей ---------------------------------------------------------
# Как часто спрашивать биржу, чем мы владеем НА САМОМ ДЕЛЕ. 0 = не сверять.
# Учёт бота — память о его же действиях, и она расходится с реальностью при
# таймаутах и частичных филлах. Без сверки расхождение живёт вечно: позиция
# висит на Polymarket и теряет в цене, а бот показывает «поз —».
FLOW_RECONCILE_S=20
# Как часто напоминать про остаток от закончившегося раунда. Такие шэры
# забирают кнопкой Redeem — книги того окна больше нет.
FLOW_LEFTOVER_WARN_S=120

# --- расчёт раунда -----------------------------------------------------------
FLOW_SETTLE_WAIT_S=20        # сколько ждать схлопывания книги после окна
FLOW_SETTLE_CONVERGE=0.90    # ниже этого победитель не объявляется

# --- журналы -----------------------------------------------------------------
FLOW_TRADE_LOG_CSV=flowbot_trades.csv
# Журнал сделок с признаками. Лежит ВНЕ папки проекта, поэтому переезд на
# новую сборку историю не обнуляет. Пусто = ~/.flowbot/trades.jsonl
FLOW_STATS_ENABLED=true
FLOW_STATS_PATH=
# Запись всего, что видит бот, в JSONL — сырьё для replay.py. "" отключает.
FLOW_RECORD_PATH=

# --- рантайм -----------------------------------------------------------------
RUN_DURATION_SECONDS=86400
STATUS_LOG_INTERVAL_SECONDS=0.1
FLOW_TICK_MAX_WAIT_S=0.05
MAX_CONSECUTIVE_ERRORS=12
