# =============================================================================
#  Пресет: python trader.py --env-file flow.env
# =============================================================================
#  ВАЖНО: этот файл в .gitignore (*.env) — ключ отсюда в git не уедет.
#  На VPS поставь ему chmod 600.
#
#  Каждый ключ здесь кто-то ЧИТАЕТ. Не добавляй параметр раньше кода, который
#  его использует: конфиг уже однажды зарос ключами, которые молча ничего не
#  делали.
# =============================================================================

# --- режим -------------------------------------------------------------------
# true  = симуляция, ордера не отправляются (начинай ОТСЮДА)
# false = РЕАЛЬНЫЕ деньги; тогда обязательны PRIVATE_KEY и FUNDER ниже
DRY_RUN=true
ASSET=btc
DRY_RUN_BALANCE=100

# --- креды (только для DRY_RUN=false) ---------------------------------------
# Приватный ключ кошелька, с которого торгуем. НИКОМУ не показывай.
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- размер и лимиты ордера --------------------------------------------------
# Размер входа по умолчанию. Стратегия может запросить свой в Action.size_usdc.
FLOW_STAKE_USDC=1.0
# Минимум площадки. Размер округляется ВВЕРХ до него: округление вниз
# опускало каждый ордер под доллар ($1.00/0.53 = 1.8867 -> 1.88 -> $0.9964),
# и площадка его отвергала.
FLOW_MIN_ORDER_USDC=1.0
# Потолок ВСЕХ вложений в один раунд — ограничение риска, а не правило
# стратегии: сколько бы сделок она ни захотела, больше этого за окно не уйдёт.
# ДЛЯ FLOW_STRATEGY=certainty он должен быть >= CERT_FULL_SIZE (то есть 50),
# иначе лестница упрётся в потолок и позиция останется неполной. Проверка
# конфига это ловит и не даёт запуститься.
FLOW_MAX_ROUND_USDC=25
# Пол цены продажи. ВЫКЛЮЧЕН (0), и это осознанно: пол противоречит смыслу
# стопа — выходить надо именно на падении, а он запрещает продавать ровно
# тогда, когда падает сильнее всего.
FLOW_MAX_SELL_SLIP=0

# --- задержки и таймауты -----------------------------------------------------
# Замерь на самом VPS или задай ориентир. Стокгольм -> Polymarket ~110-120мс.
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90
FLOW_ORDER_PROCESS_MS=45
FLOW_SIMULATE_LATENCY=true   # в dry-run честно ждать пинг перед филлом
# Сколько ждать ответа биржи. У клиента своего таймаута НЕТ, и повисший
# запрос оставлял флаг «ордер в полёте» взведённым навсегда: бот молча
# переставал торговать, продолжая печатать строки состояния.
FLOW_ORDER_TIMEOUT_S=10
# Пауза после ОТКАЗА биржи. Придерживает только ПОКУПКИ — продажу
# откладывать нельзя никогда.
FLOW_ERROR_COOLDOWN_S=5
# Сколько отказов продажи подряд терпеть, прежде чем снять позицию с торговли.
FLOW_MAX_SELL_FAILS=5

# --- сверка с биржей ---------------------------------------------------------
# Как часто спрашивать биржу, чем мы владеем НА САМОМ ДЕЛЕ. 0 = не сверять.
# Учёт бота — память о его же действиях, и она расходится с реальностью при
# таймаутах и частичных филлах. Без сверки расхождение живёт вечно: позиция
# висит на Polymarket и теряет в цене, а бот показывает «поз —».
FLOW_RECONCILE_S=20
# Как часто напоминать про остаток от закончившегося раунда. Такие шэры
# забирают кнопкой Redeem — книги того окна больше нет.
FLOW_LEFTOVER_WARN_S=120

# --- расчёт раунда -----------------------------------------------------------
FLOW_SETTLE_WAIT_S=20        # сколько ждать схлопывания книги после окна
FLOW_SETTLE_CONVERGE=0.90    # ниже этого победитель не объявляется

# --- журналы -----------------------------------------------------------------
FLOW_TRADE_LOG_CSV=flowbot_trades.csv
# Журнал сделок с признаками. Лежит ВНЕ папки проекта, поэтому переезд на
# новую сборку историю не обнуляет. Пусто = ~/.flowbot/trades.jsonl
FLOW_STATS_ENABLED=true
FLOW_STATS_PATH=
# Запись всего, что видит бот, в JSONL — сырьё для replay.py. "" отключает.
FLOW_RECORD_PATH=

# --- рантайм -----------------------------------------------------------------
RUN_DURATION_SECONDS=86400
STATUS_LOG_INTERVAL_SECONDS=0.1
FLOW_TICK_MAX_WAIT_S=0.05
MAX_CONSECUTIVE_ERRORS=12
# Сколько уровней книги отдавать стратегии. По одной лучшей цене нельзя
# отличить «$2000 в книге» от «$40 по нашей цене и частичный филл».
FLOW_BOOK_LEVELS=10

# =============================================================================
#  СТРАТЕГИЯ
# =============================================================================
# none      — бот смотрит рынок и НЕ торгует (чистый лист, flowbot/strategy.py)
# certainty — «покупка почти-факта»: YES около 0.98 в уже решённом раунде
FLOW_STRATEGY=none

# --- ЧЕМ ЭТА СТРАТЕГИЯ ЗАРАБАТЫВАЕТ -----------------------------------------
# $50 по цене 0.98 = 51.02 шэра: выигрыш +$1.02, проигрыш -$50. Порог
# безубытка = 50/51.02 = 98.00% — РОВНО цена контракта. Это тождество:
# справедливая цена по определению даёт нулевое матожидание. Значит прибыль
# бывает только там, где ИСТИННАЯ вероятность заметно выше 0.98, а книга всё
# равно показывает 0.98 (маркет-мейкеры не котируют 0.999: шаг цены целый цент).
#
# ОДНА ПОТЕРЯ СЪЕДАЕТ 49 ВЫИГРЫШЕЙ ПОДРЯД. Отсюда все пороги ниже: любая
# проверка, снижающая шанс потери на процент, окупает отказ от десятков сделок.

# --- размер и лестница -------------------------------------------------------
# Полная позиция и ступени набора. Сумма ступеней ОБЯЗАНА равняться полной
# позиции — иначе проверка конфига не пропустит запуск.
CERT_FULL_SIZE=50
CERT_STEPS=10,10,10,20
# Пауза между ступенями. Смысл не в задержке, а в НЕЗАВИСИМОСТИ данных: за это
# время приходят новые тики, и вторая ступень опирается не на то же измерение.
CERT_STEP_INTERVAL_S=3
# На сколько ужесточается порог риска с каждой ступенью.
CERT_RISK_TIGHTEN=3
# Насколько запасу разрешено просесть между ступенями, в сигмах.
CERT_Z_SLIP=0.3

# --- порог входа -------------------------------------------------------------
# Единая оценка риска 0..100 (flowbot/risk.py). Вход при score <= этого.
CERT_RISK_MAX=30
# ЗАПАС В СИГМАХ — главная величина. z = (цена-таргет)/(σ√t_остаток).
# При z=2.05 модель даёт РОВНО 0.98, то есть ровно порог безубытка: покупать
# там нечего. Прибыль начинается там, где z заметно больше (z=4 -> 0.99997).
CERT_Z_MIN=4
CERT_Z_FULL=6
CERT_MAX_PRICE=0.985     # дороже забирать нечего
CERT_MIN_PRICE=0.960     # дешевле раунд не «почти решён»
CERT_MAX_SPREAD_C=5
CERT_MIN_DEPTH_USD=60
# Окно входа. Раньше — раунд ещё живой; позже — ордер может не успеть.
CERT_MIN_SECONDS_LEFT=10
CERT_MAX_SECONDS_LEFT=120

# --- измерения ---------------------------------------------------------------
CERT_VOL_FAST_S=10
CERT_VOL_SLOW_S=60
# ЗАПАС НАДЁЖНОСТИ НА σ. Измерено в этом проекте: оценка по MAD занижает
# нужную для Φ величину в 1.4-1.6 раза на скачковых данных. Заниженная σ
# завышает z, а завышенный z — прямая дорога к потере полной ставки.
CERT_SIGMA_SAFETY=1.5
CERT_SIGMA_FLOOR=0.2
CERT_BIDDROP_S=5         # за сколько секунд смотреть уход бидов

# --- защита от потери связи --------------------------------------------------
# Обрыв потока изнутри выглядит как «рынок замер»: цены в книге те же, что
# были в момент разрыва. Отличить можно только по времени.
CERT_MAX_STALE_S=2       # цена монеты не обновлялась
CERT_MAX_BOOK_STALE_S=5  # книга не менялась

# --- аварийный выход ---------------------------------------------------------
# Выход НЕ по проценту: он проваливается до 0.50 и возвращается на 0.98 за
# секунду. Выходим по состоянию РЫНКА и только с подтверждением.
CERT_EXIT_Z=2.5          # запас упал ниже этого
CERT_EXIT_JUMP_MULT=1.5  # или запас < столько худших наблюдённых секунд
CERT_EXIT_CONFIRM_TICKS=5   # столько тактов подряд
CERT_EXIT_CONFIRM_S=1.5     # и не меньше стольких секунд
CERT_NO_EXIT_LAST_S=8    # у конца окна выходить некуда: книга тонкая

# --- дневной риск ------------------------------------------------------------
# Лимит по СОБЫТИЯМ, а не по деньгам: одна потеря стоит 49 выигрышей, поэтому
# считать надо потери, а не сумму.
CERT_MAX_DAY_LOSSES=1
CERT_MAX_DAY_LOSS_USD=60
CERT_MAX_DAY_TRADES=40
