# =============================================================================
#  Polymarket Crypto Up/Down 5m bot — configuration
#  Copy this file to `.env` and edit. `.env` is gitignored (keep your key safe).
# =============================================================================

# ---------------------------------------------------------------------------
#  SAFETY: run mode
# ---------------------------------------------------------------------------
# DRY_RUN=true  -> the bot does EVERYTHING (watches markets, evaluates the
#                  strategy, "buys") but places NO real orders. Start here.
# DRY_RUN=false -> the bot places REAL orders with REAL money. Requires the
#                  credentials below.
DRY_RUN=true

# Simulated starting balance used in dry-run when no credentials are provided.
DRY_RUN_BALANCE=100.0

# ---------------------------------------------------------------------------
#  COIN / MARKET
# ---------------------------------------------------------------------------
# Which coin's Up/Down 5m market to trade: btc / eth / sol / xrp.
# The market slug becomes  <ASSET>-updown-5m-<window_ts>.
ASSET=btc
# Spot price fallback (display + distance filter when the live feed is down).
# Match it to ASSET:  BTC-USD / ETH-USD / SOL-USD / XRP-USD.
BTC_PRICE_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot

# ---------------------------------------------------------------------------
#  STRATEGY
# ---------------------------------------------------------------------------
PRICE_MIN=0.84               # buy only if outcome price >= this
PRICE_MAX=0.99               # buy only if outcome price <= this
TIME_WINDOW_SECONDS=70       # buy only if <= this many seconds remain (1m10s)
# Only buy when the coin has moved at least this many USD away from the
# window's open price ("target"/strike) in the favourite's direction. 0 = off.
MIN_TARGET_DISTANCE_USDC=0
TRADE_SIZE_USDC=5.0          # USDC spent per trade (Polymarket min is ~$5)
MIN_BALANCE_USDC=1.0         # stop the bot if balance drops to/below this
RUN_DURATION_SECONDS=86400   # how long the bot runs (default 24h). Or use --hours
POLL_INTERVAL_SECONDS=1.0    # how often to check the market (seconds)

# ---------------------------------------------------------------------------
#  EARLY/LATE PRICE RULE (time-based band)
# ---------------------------------------------------------------------------
# With MORE than EARLY_THRESHOLD_SECONDS left in the window the bot buys ONLY
# at EARLY_PRICE_MIN..PRICE_MAX (default: only at 0.99) and, when
# EARLY_REQUIRE_RISING=true, only while that side's price is rising (the price
# now is at/above where it was TREND_LOOKBACK_SECONDS ago). With
# EARLY_THRESHOLD_SECONDS or less left, the normal PRICE_MIN..PRICE_MAX band
# applies with no trend check. Set EARLY_THRESHOLD_SECONDS=0 to disable.
EARLY_THRESHOLD_SECONDS=120
EARLY_PRICE_MIN=0.99
EARLY_REQUIRE_RISING=true
TREND_LOOKBACK_SECONDS=30

# Which price drives the buy decision and is paid:
#   ask  -> best ask (what you actually pay to buy)  [recommended/default]
#   mid  -> order-book midpoint
#   last -> last traded price
PRICE_SOURCE=ask

# CSV trade log: every settled trade is appended here. Set empty to disable.
TRADE_LOG_CSV=trades.csv

# Optional "lottery hedge": right after the main buy, arm a RESTING order on the
# OPPOSITE outcome at a very low price. It waits on the book and fills when the
# opposite trades down to HEDGE_PRICE during the window (live = a real GTC order;
# dry-run = filled on the first tick the opposite ask reaches HEDGE_PRICE). If
# the favourite loses, the opposite pays ~$1/share and offsets the loss.
# HEDGE_ENABLED=false turns it off.
HEDGE_ENABLED=false
HEDGE_PRICE=0.01             # resting limit price for the opposite outcome
HEDGE_SIZE_USDC=1.0          # USDC spent on the opposite outcome

# Optional stop-loss: after the buy fills, watch the position's sell price (bid):
#  * soft — bid <= STOPLOSS_SOFT_PRICE and <= STOPLOSS_SOFT_SECS_TO_END seconds
#    left -> sell to recover cash before expiry;
#  * hard — bid <= STOPLOSS_HARD_PRICE -> sell immediately, any time left.
STOPLOSS_ENABLED=false
STOPLOSS_SOFT_PRICE=0.50
STOPLOSS_SOFT_SECS_TO_END=8
STOPLOSS_HARD_PRICE=0.46

# ---------------------------------------------------------------------------
#  RESILIENCE
# ---------------------------------------------------------------------------
MAX_RETRIES=4                # per-request retries on transient API errors
BACKOFF_BASE_SECONDS=2.0     # backoff = base^attempt -> 2s, 4s, 8s, 16s
MAX_BACKOFF_SECONDS=16.0
MAX_CONSECUTIVE_ERRORS=8     # safe-stop after this many failed cycles in a row
HTTP_TIMEOUT_SECONDS=10.0

# ---------------------------------------------------------------------------
#  LIVE TRADING CREDENTIALS  (only needed when DRY_RUN=false)
# ---------------------------------------------------------------------------
# Private key of the wallet that signs orders. If you deposited on the
# Polymarket website, export it from: Polymarket -> profile -> Settings ->
# "Export Private Key". Keep this SECRET.
PRIVATE_KEY=

# The address that actually HOLDS your funds (your Polymarket deposit address).
# For website (email/Magic) accounts this is your Polymarket proxy address.
FUNDER=

# Signature type of your account:
#   0 = raw EOA wallet (you hold USDC directly in the key above)
#   1 = Email / Magic login (Polymarket website default)
#   2 = Browser wallet (MetaMask etc.) proxy
#   3 = Polymarket deposit-wallet accounts (POLY_1271)
SIGNATURE_TYPE=1

# Optional: pre-derived CLOB API credentials. If left blank the bot derives
# them automatically from PRIVATE_KEY on startup.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ---------------------------------------------------------------------------
#  ENDPOINTS / ADVANCED (defaults are fine)
# ---------------------------------------------------------------------------
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
# Polymarket site host — used to read the EXACT target/strike (window open
# price) from /api/crypto/crypto-price, i.e. the same number Polymarket shows.
POLY_HOST=https://polymarket.com

# Live price feed: stream the Chainlink <ASSET>/USD price Polymarket actually
# shows and resolves on (via its live-data WebSocket), so the displayed price
# moves in real time instead of lagging Coinbase spot. Needs `websocket-client`
# installed; set false (or if it can't connect) to fall back to spot.
LIVE_PRICE_ENABLED=true
LIVE_PRICE_WS=wss://ws-live-data.polymarket.com
CHAIN_ID=137
