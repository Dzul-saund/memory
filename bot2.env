# =============================================================================
#  PRESET "Bot 2" — ETHEREUM (ETH Up/Down 5m)
#  Run with:  python run.py --env-file bot2.env
#
#  All four bots share the SAME strategy (taken from the old bot4):
#    * stake $50, band 0.98..0.99, no time limit, no target cushion, no hedge,
#      stop-loss on;
#    * EARLY/LATE rule: with MORE than 120s left buy ONLY at 0.99 and only
#      while the price is rising; with 120s or less left buy at 0.98..0.99.
#  The only difference between bot1..bot4 is the coin.
# =============================================================================

# Coin traded by THIS bot (market slug becomes eth-updown-5m-<ts>)
ASSET=eth
BTC_PRICE_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot

DRY_RUN=false
DRY_RUN_BALANCE=500.0

# --- strategy (same conditions as bot4) -------------------------------------
TRADE_SIZE_USDC=50.0           # stake $50 per trade
PRICE_MIN=0.98                 # normal band 0.98 .. 0.99 (<= 120s left)
PRICE_MAX=0.99
TIME_WINDOW_SECONDS=600        # no time limit (window is <=300s, so always open)
MIN_TARGET_DISTANCE_USDC=0     # no distance-from-target limit

# --- early/late rule ---------------------------------------------------------
# > 120s left  -> buy ONLY at 0.99, and only while that side's price is rising
#                 (now >= where it was TREND_LOOKBACK_SECONDS ago)
# <= 120s left -> normal band PRICE_MIN..PRICE_MAX (0.98..0.99), no trend check
EARLY_THRESHOLD_SECONDS=120
EARLY_PRICE_MIN=0.99
EARLY_REQUIRE_RISING=true
TREND_LOOKBACK_SECONDS=30

# no hedge
HEDGE_ENABLED=false

MIN_BALANCE_USDC=1.0
POLL_INTERVAL_SECONDS=0.2
RUN_DURATION_SECONDS=86400
PRICE_SOURCE=ask
TRADE_LOG_CSV=bot2_trades.csv

# --- fair-probability model (own P(Up) check) ---------------------------------
# The bot computes its OWN probability that the coin finishes on the bought
# side: P = Phi(distance_from_target / (sigma * sqrt(seconds_left))), with
# sigma measured live from the Chainlink stream. It buys only when its own
# estimate is >= MODEL_MIN_PROB — so a quoted 0.98/0.99 must be backed by the
# math, not just a thin order book (break-even at 0.99 entry is 99.0%).
# MODEL_STRICT=true: no estimate yet (first ~30s after start) -> no buy.
MODEL_FILTER_ENABLED=true
MODEL_MIN_PROB=0.995
MODEL_VOL_LOOKBACK_SECONDS=120
MODEL_STRICT=true

# --- speed -------------------------------------------------------------------
# Live order books over WebSocket: bid/ask updates arrive in MILLISECONDS
# instead of HTTP polling every cycle (needs websocket-client; falls back to
# HTTP automatically). Market lookup is cached per window; balance is cached
# for BALANCE_REFRESH_SECONDS and refreshed right after every order. The loop
# runs every POLL_INTERVAL_SECONDS (0.2s = 5 checks per second); the status
# line is printed once per STATUS_LOG_INTERVAL_SECONDS to keep logs readable.
BOOK_FEED_ENABLED=true
BALANCE_REFRESH_SECONDS=5
STATUS_LOG_INTERVAL_SECONDS=1.0

# --- resilience (defaults) ---------------------------------------------------
MAX_RETRIES=4
BACKOFF_BASE_SECONDS=2.0
MAX_BACKOFF_SECONDS=16.0
MAX_CONSECUTIVE_ERRORS=8
HTTP_TIMEOUT_SECONDS=10.0

# --- live credentials (required because DRY_RUN=false) -----------------------
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- endpoints ---------------------------------------------------------------
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# --- stop-loss (same as bot4) -------------------------------------------------
# After the buy fills, watch the position's sell price (bid):
#  * if it is <= 0.50 AND <= 8s remain before the window ends -> sell to save cash
#  * if it drops to/below 0.46 -> sell immediately (any time left)
STOPLOSS_ENABLED=true
STOPLOSS_SOFT_PRICE=0.50
STOPLOSS_SOFT_SECS_TO_END=8
STOPLOSS_HARD_PRICE=0.46
