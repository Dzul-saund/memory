# =============================================================================
#  ГОТОВЫЙ ПРЕСЕТ стратегии «покупка почти-факта»
#
#      cp cert.env.example cert.env
#      chmod 600 cert.env
#      python trader.py --env-file cert.env
#
#  Здесь только то, что отличается от значений по умолчанию. Всё остальное
#  берётся из flowbot/config.py — полный список с пояснениями лежит в
#  flow.env.example.
#
#  ЭТОТ ФАЙЛ (cert.env, не .example) В .gitignore — в нём приватный ключ.
# =============================================================================

# --- РЕЖИМ. Начинай ОТСЮДА и не трогай, пока не отсмотришь сотни раундов ----
DRY_RUN=true
ASSET=btc
DRY_RUN_BALANCE=100

# --- креды (нужны ТОЛЬКО при DRY_RUN=false) ---------------------------------
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- стратегия ---------------------------------------------------------------
FLOW_STRATEGY=certainty

# Полная позиция $50 лестницей 10/10/10/20. Потолок раунда обязан её вмещать.
CERT_FULL_SIZE=50
CERT_STEPS=10,10,10,20
FLOW_MAX_ROUND_USDC=50
FLOW_MIN_ORDER_USDC=1

# Главный порог: запас до таргета в сигмах. z=2.05 — это ровно 0.98, то есть
# ровно безубыток; покупать там нечего. Ниже z=4 вход запрещён.
CERT_Z_MIN=4

# Дневной риск: одна потеря = 49 выигрышей, поэтому после первой — стоп.
CERT_MAX_DAY_LOSSES=1
CERT_MAX_DAY_LOSS_USD=60
CERT_MAX_DAY_TRADES=40

# --- пинг: замерь на самой машине, откуда торгуешь ---------------------------
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90

# --- журналы -----------------------------------------------------------------
# Журнал сделок лежит ВНЕ папки проекта (~/.flowbot/trades.jsonl), поэтому
# переезд на новую сборку историю не обнуляет.
FLOW_STATS_ENABLED=true
FLOW_STATS_PATH=
FLOW_TRADE_LOG_CSV=flowbot_trades.csv
# Запись рынка для replay.py. ВНИМАНИЕ: ~10 ГБ в сутки — такт случается на
# каждом событии книги, а не по таймеру. Включай, когда собираешь выборку.
FLOW_RECORD_PATH=
