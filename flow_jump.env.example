# =============================================================================
#  Пресет 4-й (СКАЧКОВОЙ) системы — python jump_trader.py --env-file flow_jump.env
# =============================================================================
#  Правила целиком описаны в JUMP.md. Здесь только цифры, которые крутятся.
#  ВАЖНО: этот файл в .gitignore (bot*.env / *.env) — ключ отсюда не уедет
#  в git. На VPS поставь ему chmod 600.
# =============================================================================

# --- режим -------------------------------------------------------------------
# true  = симуляция, ордера не отправляются (начинай ОТСЮДА)
# false = РЕАЛЬНЫЕ деньги; тогда обязательны PRIVATE_KEY и FUNDER ниже
DRY_RUN=true
ASSET=btc

# --- креды (только для DRY_RUN=false) ---------------------------------------
# Приватный ключ кошелька, с которого торгуем. НИКОМУ не показывай.
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- ЧТО СЧИТАЕМ ПОВОДОМ ВОЙТИ -----------------------------------------------
# Четыре режима. Всё остальное (лестница, фиксация, потолки) у них ОБЩЕЕ —
# поэтому их запуски можно сравнивать напрямую: меняется ровно одна вещь.
# Разные режимы = разные замки и разные файлы, их держат запущенными
# одновременно.
#
#   jump    — скачок цены в долларах. Исходная идея. Известный изъян: скачка
#             нет ни в одном члене EV = p − ask, поэтому он и не нужен (сигнал
#             бывает без скачка: время идёт, sigma падает, книга зевает), и не
#             достаточен (скачок $10 на 15 сигмах не двигает процент).
#   edge    — запас цены: Phi(z) − ask по обеим сторонам, берём лучшую. Ровно
#             то, что стоит в EV. Скачок падает до уровня признака.
#   lag     — отставание якоря: Phi(z по НАШЕЙ цене) − Phi(z по цене
#             Polymarket). Говорит не только «книга дешевле справедливого», но
#             и ПОЧЕМУ (считает по устаревшей цене), и насколько (~288мс).
#   impulse — КАЧЕСТВО движения, а не его размер. Старый триггер спрашивал
#             «прошла ли цена достаточно?» и не различал рывок с продолжением,
#             плавный дрейф (книга давно переоценила) и вынос ликвидности с
#             мгновенным откатом. Здесь движение описано пятью величинами
#             (скачок в sigma, скорость, ускорение, удержание хода, возраст
#             экстремума), из них считается оценка качества Q, и она же
#             задаёт ставку и потолок цены. Дорожек A/B нет: одинаковый
#             импульс оценивается одинаково при любой цене контракта, цена
#             входит только как риск (дороже -> строже требование к запасу).
JUMP_ENTRY_MODE=jump
JUMP_LAG_MIN_CENTS=3.0       # на сколько книга обязана переоцениться (режим lag)
JUMP_LAG_MAX_AGE_MS=1500     # якорь старше этого — дырка в потоке, не сигнал

# --- вход: что считаем «резким скачком» (режим jump) -------------------------
# КАК ловим движение:
#   swing  — от локального дна/пика. Цена ушла на $5 от экстремума — покупаем
#            в ТОТ ЖЕ ТИК, сколько бы времени движение ни заняло. Никакого
#            окна, мониторинг непрерывный. ЭТО РЕЖИМ ПО УМОЛЧАНИЮ.
#   window — старый способ: сравнить цену сейчас и JUMP_WINDOW_S назад.
#            Движение, растянувшееся дольше окна, будет пропущено.
JUMP_TRIGGER_MODE=swing
# Как далеко назад может лежать дно/пик (только для swing).
# Больше = ловим и длинные движения, но «дном» рискует стать начало раунда.
# Меньше = ближе к поведению окна. 30-90 разумно.
JUMP_SWING_LOOKBACK_S=60
JUMP_WINDOW_S=3.0            # окно режима window (в swing не используется)

JUMP_SMALL_USD=5.0           # дорогая сторона (>= сплита): хватает $5
JUMP_BIG_USD=15.0            # дешёвая сторона (< сплита): нужно $15
JUMP_PRICE_SPLIT=0.51        # граница «дорого/дёшево» по проценту
JUMP_STAKE_USDC=1.0          # первая ставка в раунде

# ПОДСТРОЙКА ПОД ЖИВОСТЬ РЫНКА.
# $5 и $15 выше верны только для той волатильности, при которой их подбирали
# (тихое воскресенье, sigma ~0.9). Когда рынок просыпается, тот же скачок
# двигает процент во столько же раз слабее — и порог поднимается автоматически:
#   sigma 0.9 -> нужен скачок $5      sigma 4.0 -> $22      sigma 6.0 -> $33
# Выключить (вернуть жёсткие $5/$15): JUMP_ADAPTIVE=false
JUMP_ADAPTIVE=true
JUMP_SIGMA_REF=0.9           # sigma, при которой калиброваны $5/$15
JUMP_SCALE_MIN=1.0           # ниже базовых порогов не опускаемся
JUMP_SCALE_MAX=8.0           # и не разгоняемся без предела

# Как далеко от таргета ещё лезем дешёвой стороной — в СИГМАХ, не в долларах.
# «Далеко» зависит от волатильности: 3 сигмы это $38 при тихом рынке
# и $255 при разогнанном. Именно поэтому фиксированные $100 не работали.
JUMP_MAX_TARGET_SIGMAS=3.0
JUMP_MAX_TARGET_DIST_USD=100 # запасной предел, пока sigma неизвестна

# ФИЛЬТР «сдвинется ли процент вообще» (в центах).
# Далеко от таргета исход раунда уже решён, и процент не реагирует на скачки
# цены — вход туда съедается спредом (~1 цент). Бот считает ожидаемый сдвиг
# по модели P = Phi((цена-таргет)/(sigma*sqrt(t))) и пропускает сигнал, если
# сдвиг меньше порога. Что важно: порог в ДОЛЛАРАХ тут не работает, потому
# что «далеко» зависит от волатильности — фильтр учитывает её сам.
# 0 = выключить. В логе видно как «чувств 4.2¢» в строке состояния.
JUMP_MIN_SHIFT_CENTS=2.0

# ЗАПАС ЦЕНЫ (в центах) — самая важная проверка из всех.
# Скачок говорит, КУДА пошла цена, но молчит о том, не заложен ли он уже
# в процент. Бот считает справедливую цену стороны по той же модели, что
# показывает P(UP) в мониторе, и сравнивает с тем, что просят в книге:
#     запас = справедливая_цена − ask
# Если справедливо 60¢, а просят 94¢ — покупать нечего, сколько бы ни
# прыгнула цена. Порог должен покрывать половину спреда (при спреде 5¢
# это 2.5¢) плюс запас на пинг. 0 = выключить.
JUMP_MIN_EDGE_CENTS=3.0

# Пауза после сделки. ВЫКЛЮЧЕНА (0), и это осознанно: пауза в секунду
# останавливает не «вторую позицию на том же движении», а ЛЕСТНИЦУ —
# на активном рынке нога успевает провалиться быстрее, чем пауза истечёт.
# От повторного входа на одном и том же движении защищает не таймер, а
# сброс трекера импульса после сделки: экстремум забыт, считать заново не
# от чего. Ненулевое значение имеет смысл только для отладки.
JUMP_REENTRY_COOLDOWN_S=0

# Поздний вход: последние FLOW_SETTLE_HOLD_S секунд окна (деф. 6).
# true  = покупать МОЖНО, но только сторону, которая уже стоит дороже
#         JUMP_PRICE_SPLIT (то есть рынок уже назвал её победителем).
#         Смысл: за 6 секунд до расчёта цена 0.97 при вероятности ~1.0 —
#         это последний кусок премии за определённость, а не ставка.
# false = прежнее поведение, окно закрыто полностью.
JUMP_LATE_ENTRY=true

# =============================================================================
#  РЕЖИМ impulse — качество движения
# =============================================================================
# Насколько назад ищем экстремум, от которого меряем ход. 60 секунд (как в
# swing) — это про «где было дно раунда», а не про текущее движение: за
# минуту книга успевает переоценить всё. 10-20 разумно.
JUMP_IMP_LOOKBACK_S=15

# РЕШЕНИЕ О ВХОДЕ — ОДНА ОЦЕНКА, А НЕ ВОСЕМЬ ОБЯЗАТЕЛЬНЫХ ВОРОТ.
#
# Как было: каждый признак имел право отменить сделку в одиночку. Провалил
# один из восьми порогов — отказ, остальные признаки даже не считались. На
# практике это значило, что сильный сигнал пропадал из-за возраста импульса
# 8.2 секунды вместо 8.0. Один промах на два процента перечёркивал пять
# хороших признаков, и сделок почти не стало.
#
# Как стало: каждый признак даёт оценку 0..1 по своей шкале, оценки
# складываются с весами, и решение принимается ОДИН раз — по итоговому
# Score. Просевший признак снижает качество сделки, а не отменяет её.
#
# Шкалы заданы в flowbot/score.py. Настройки ниже РАСТЯГИВАЮТ их под свои
# опорные пороги, поэтому все прежние ручки продолжают работать и
# перебираются через replay.
JUMP_IMP_MIN_SCORE=0.70      # единственный порог решения (Score в [0..1])

# ВНИМАНИЕ ПРИ ОБНОВЛЕНИИ СО СТАРОГО .env
# Раньше эта величина считалась иначе: «1.0 = все компоненты ровно на
# порогах», и могла быть сколь угодно больше единицы. Теперь Score не
# превышает 1.0, поэтому старое значение 1.0 (и тем более 1.5) означало бы
# «не торговать никогда». Бот проверяет это на старте и отказывается
# запускаться с внятным сообщением, а не молчит.

# НОЛЬ ПО ЛЮБОМУ ПРИЗНАКУ ОТМЕНЯЕТ ВХОД.
# В шкалах ноль означает не «слабо», а «у нужного нам сигнала так не
# бывает»: удержание ниже 60% — вынос ликвидности, ход меньше 1.5σ — шум,
# скорость ниже 0.7σ — движение уже кончилось. Без этого правила
# средневзвешенное 0.89 покупало бы ровно тот вынос ликвидности, ради
# отсева которого вся конструкция и строилась. Всё, что больше нуля, ничего
# не блокирует и работает только через вес.
JUMP_SCORE_VETO_ZERO=true

# ОПОРНЫЕ ПОРОГИ ШКАЛ (в σ, не в долларах — $5 это огромный ход в тихое
# воскресенье и шум в среду). Шкала растягивается пропорционально: чем выше
# опорный порог, тем строже вся шкала целиком.
JUMP_IMP_JUMP_SIGMAS=2.0     # ход: 2.5σ -> 1.0, 2.0σ -> 0.8, 1.5σ -> 0.4
JUMP_IMP_SPEED_SIGMAS=1.0    # скорость: 1.5σ/с -> 1.0, 0.9σ/с -> 0.6
JUMP_IMP_MIN_HOLD=0.7        # удержание: 95% -> 1.0, 70% -> 0.6, <60% -> 0
JUMP_IMP_MIN_ACCEL=0.5       # ускорение: 1.2 -> 1.0, 0.6 -> 0.5, <0.4 -> 0
JUMP_IMP_MAX_AGE_S=8         # возраст: до 4с -> 1.0, до 8с -> 0.7, >12с -> 0

# СТАВКА ОТ КАЧЕСТВА — ВЫКЛЮЧЕНА, и это осознанно.
# Ступени $1/$2/$4/$8 рвали непрерывное качество на куски: Q=2.99 покупал на
# $4, Q=3.01 — на $8, хотя сигналы неразличимы. Хуже другое: пока пороги не
# подтверждены историей, множитель к ставке множит и ошибку, и вдобавок
# ломает саму статистику — разный размер позиции смешивает «сигнал был лучше»
# с «мы поставили больше», и разделить их потом нечем.
JUMP_STAKE_BY_QUALITY=false
JUMP_Q_GOOD=0.80             # Score >= этого -> JUMP_STAKE_GOOD
JUMP_Q_STRONG=0.88           # Score >= этого -> JUMP_STAKE_STRONG
JUMP_Q_BEST=0.95             # Score >= этого -> JUMP_STAKE_BEST
JUMP_STAKE_GOOD=2.0
JUMP_STAKE_STRONG=4.0
JUMP_STAKE_BEST=8.0

# --- СТРУКТУРА КНИГИ ЗАЯВОК (flowbot/bookfeat.py) ----------------------------
# Стратегия отлично читала ЦЕНУ и почти не читала КНИГУ. Между тем книга
# часто говорит раньше цены: с одной стороны втрое больше заявок; ликвидность
# с пути движения снимают; встала крупная лимитка-стена.
JUMP_BOOK_LEVELS=5           # сколько уровней считать глубиной
JUMP_BOOK_WINDOW_S=3         # за какое окно мерить изменение глубины

# ЖЁСТКИЕ ВОРОТА ПО КНИГЕ ВЫКЛЮЧЕНЫ (0), и это не лень.
# Признаки уже считаются и пишутся в журнал КАЖДОЙ сделки. Включать их в
# отбор до того, как по журналу видно их влияние, — ровно та ошибка, на
# которой проект уже обжигался дважды: сначала измерить, потом фильтровать.
JUMP_BOOK_MIN_IMBALANCE=0    # требовать перекос в нашу сторону, [0..1]
JUMP_BOOK_MAX_WALL=0         # доля крупнейшей заявки в ask, [0..1]

# ЗАПАС ЦЕНЫ ОТ СПРЕДА, а не константой. Спред НЕ константа: 5 центов около
# таргета при 0.89/0.94 и 1 цент на решённом раунде при 0.97/0.98. Значит
# фиксированные 3 цента местами завышены (пропускаем годное), местами
# занижены (входим в убыток по спреду). Требование: перекрыть спред с
# запасом. Итог = max(JUMP_MIN_EDGE_CENTS, JUMP_EDGE_SPREAD_MULT * спред).
JUMP_EDGE_SPREAD_MULT=2.0

# ПОТОЛОК ЦЕНЫ ОТ КАЧЕСТВА. Дорогая сторона — это не «плохо», это риск:
# при 0.97 ошибка стоит 97 центов, а заработать можно 3. Поэтому слабому
# сигналу дорого лезть запрещено, сильному — можно.
JUMP_MAX_LEG_PRICE_WEAK=0.92     # Q ниже JUMP_Q_GOOD
JUMP_MAX_LEG_PRICE_STRONG=0.97   # Q от JUMP_Q_STRONG (между ними —
                                 # линейно, ~0.94-0.95)

# --- лестница добора ---------------------------------------------------------
JUMP_LADDER_ENABLED=true
JUMP_LADDER_PROFIT_USDC=0.50 # какой «+» закладываем в перекрытие минуса
JUMP_LADDER_GRACE_S=0.6      # % должен продержаться под сплитом столько
JUMP_LADDER_LOSS=0.02        # и уйти на столько ниже своей цены входа

# РАЗВОРОТ БОЛЬШЕ НЕ ПОКУПАЕТ ВСЛЕПУЮ.
# Прежняя логика молча принимала, что убыток по одной стороне —
# ПОДТВЕРЖДЕНИЕ другой. Это почти никогда не верно: рынок мог просто встать,
# тогда плохи обе стороны, а автоматический переворот лишь удваивал число
# сделок и риск.
# true  = разворот ЗАКРЫВАЕТ убыточную ногу и всё. Обратная сторона обязана
#         заново пройти все проверки как новая сделка.
# false = прежний переворот (продать и сразу купить обратную на перекрытие
#         долга). Оставлен, чтобы их можно было сравнить на записи:
#         python replay.py market.jsonl --sweep ladder-reenters true false
JUMP_LADDER_REENTERS=true
# И планка для повторного входа ВЫШЕ обычной: переворот рискованнее первого
# входа, значит сигнал обязан быть сильнее среднего. Шкала та же, [0..1].
JUMP_LADDER_MIN_Q=0.80
JUMP_LADDER_STRICT_S=30      # сколько секунд действует повышенная планка

# ЛЕСТНИЦА ТЕПЕРЬ ПРОДАЁТ провалившуюся ногу, а не держит её. Это меняет
# всё: продажа возвращает капитал, и в долге остаётся только реализованный
# убыток ноги, а не вся её стоимость.
#   держим старую: долг 1.00 -> 2.50 -> 5.50 -> 11.50 -> 23.50 (взрыв)
#   продаём:       долг 1.00 -> 0.45 -> 0.29 ->  0.24 ->  0.22 (сходится)
# Поэтому предел ступеней не нужен: 0 = БЕЗ ОГРАНИЧЕНИЙ.
JUMP_MAX_LADDER_LEGS=0       # 0 = без предела; число = жёсткий лимит
JUMP_MAX_ROUND_USDC=25.0     # потолок ВСЕХ вложений в один раунд
JUMP_MAX_LEG_PRICE=0.95      # дороже не добираем: шэров нужно слишком много

# ЖЁСТКИЙ СТОП: процент ушёл ниже нашего входа — выходим сразу, не дожидаясь
# ни лестницы, ни трейлинга.
# ОТСЧЁТ ОТ БИДА НА ВХОДЕ, а не от уплаченного ask. Спред означает, что сразу
# после покупки бид уже ниже ask, и стоп от ask закрывал бы КАЖДУЮ сделку в
# тот же тик с гарантированным убытком.
JUMP_STOP_LOSS=0.01

# ЧТО ГЛАВНЕЕ — РАЗВОРОТ ИЛИ ВЫХОД.
# Порог стопа (1¢) МЕНЬШЕ порога лестницы (2¢ + выдержка 0.6с), поэтому по
# цене стоп наступает раньше ВСЕГДА, и при включённом стопе лестница почти
# не случалась. Одного изменения порядка проверок мало — нужно, чтобы стоп
# СТОЯЛ В СТОРОНЕ, пока ногу способен взять разворот.
#
# true  = так и есть. Стоп становится СТРАХОВКОЙ и срабатывает ровно тогда,
#         когда развернуться не во что: лестница выключена, упёрлась в
#         предел ступеней, у обратной стороны нет ask или она дороже
#         JUMP_MAX_LEG_PRICE, расчёт дал 0 шэров, либо идёт пауза после
#         отказа биржи (разворот — это покупка, а покупки на паузе).
# false = прежнее поведение: стоп режет первым, лестница редка.
#
# Плата за true названа честно: между 1¢ и 2¢ нога больше не режется, и в
# течение выдержки 0.6с падение может уйти дальше. Это размен «выйти дёшево»
# против «отыграться разворотом». Какая сторона выгоднее — НЕИЗВЕСТНО, пока
# нет записи рынка; решается одной командой:
#     python replay.py market.jsonl --sweep ladder-first true false
JUMP_LADDER_BEFORE_STOP=true

# СТОП ТОЖЕ ПОДСТРАИВАЕТСЯ ПОД ВОЛАТИЛЬНОСТЬ. 1 цент — это порог, снятый при
# sigma~0.9; при sigma=4 такое колебание происходит само по себе несколько раз
# в секунду, и стоп режет живые позиции шумом. Правило то же, что у порогов
# входа: считаем в sigma, а не в центах.
#   итог = ограничить(JUMP_STOP_LOSS * sigma/JUMP_SIGMA_REF,
#                     JUMP_STOP_LOSS, JUMP_STOP_MAX)
# false = жёсткие JUMP_STOP_LOSS центов при любой волатильности.
JUMP_STOP_ADAPTIVE=true
JUMP_STOP_MAX=0.05           # и не разрастаться без предела

# ВЫХОД ПО СМЕРТИ СКОРОСТИ. Отдельный от трейлинга и работает раньше него:
# трейлинг ждёт, пока цена ОТКАТИТСЯ на 2 цента, а к этому моменту книга уже
# всё поняла. Здесь смотрим на монету: движение, которое нас завело, встало.
# Условие — скорость упала более чем на эту долю от пиковой скорости ноги.
# 0 = выключить.
JUMP_EXIT_SPEED_DROP=0.7
# Порог не применяется к слабым импульсам: падение с 0.2 $/с до 0.05 $/с —
# это тоже «−75%», но там и падать было нечему. Пиковая скорость ноги должна
# быть хотя бы столько sigma в секунду, иначе выход молчит.
JUMP_EXIT_SPEED_FLOOR=2.0

# Пол цены продажи: на сколько ниже цены решения согласны отдать ногу.
# ВЫКЛЮЧЕН, и это осознанно. Пол противоречит смыслу стопа: стоп нужен,
# чтобы ВЫЙТИ на падении, а пол запрещает продавать именно тогда, когда
# падает сильнее всего — чем быстрее рушится цена, тем упорнее бот держит.
# В бою нога съехала с 0.47 до 0.10 при стопе, стоявшем на 0.45.
# Продаём по текущему биду, как и было в симуляции.
JUMP_MAX_SELL_SLIP=0

# Пауза после ОТКАЗА биржи. Сигнал держится, пока держится рынок, поэтому
# без паузы отклонённый ордер повторяется на каждом такте — десять раз в
# секунду. Первый живой запуск дал ровно это.
JUMP_ERROR_COOLDOWN_S=5.0

# Как часто сверять свой учёт позиций С БИРЖЕЙ, секунд. 0 = не сверять.
# Учёт бота — это память о его же действиях, и она расходится с реальностью
# при таймаутах, частичных филлах и неверно разобранных ответах. Без сверки
# расхождение живёт вечно: на Polymarket позиция висит и теряет в цене, а
# бот показывает «поз —» и ничего не делает, потому что управлять он может
# только тем, о чём знает. Биржа — источник истины.
JUMP_RECONCILE_S=20

# Как часто напоминать про ОСТАТОК от закончившегося раунда, секунд.
# Нога, дожившая до конца окна, остаётся на балансе: выплату по ней забирают
# кнопкой Redeem/Claim, а не продажей — книги этого раунда больше нет, и
# «Market Sell» на сайте отвечает «balance: 0». Сверка такие токены не теряет
# из вида, но кричать про один и тот же остаток каждые 20с — утопить в этом
# остальной лог. В строке состояния он виден всегда как «+ост N (Redeem)».
JUMP_LEFTOVER_WARN_S=120

# Сколько ждать ответа биржи на ордер. У клиента своего таймаута НЕТ, и без
# этого повисший запрос оставлял флаг «ордер в полёте» взведённым навсегда:
# бот молча переставал торговать, продолжая печатать «покупаю» в лог.
FLOW_ORDER_TIMEOUT_S=10.0

# Минимальный размер ордера в USDC.
# ВАЖНО: размер покупки считается ЦЕЛЫМИ шэрами. Polymarket отвергает суммы
# длиннее двух знаков после запятой (0.57 * 1.76 = $1.0032 -> ошибка 400), а
# при цене в целых центах два знака гарантирует только целое число шэров.
# Поэтому фактическая трата бывает выше ставки: $1 по цене 0.57 -> 2 шэра
# = $1.14, по 0.95 -> 2 шэра = $1.90.
JUMP_MIN_ORDER_USDC=1.0

# --- фиксация прибыли (ОБЕ дорожки) ------------------------------------------
# Закрывает случай «вышли в хороший плюс, досидели до расчёта и ушли в минус».
JUMP_TP_ENABLED=true
JUMP_TP_MIN_GAIN=0.10        # фиксируем, только если в плюсе хотя бы на это

# ТРЕЙЛИНГ-СТОП — главный выход. На сколько разрешено откатиться от ПИКА.
# Без него у достигнутой прибыли не было защиты вообще: остальные триггеры
# требуют совпадений, которых на откате не бывает (застой 8с — а процент
# падает за 2; «замерла монета» — а монета движется), плюс проверка «мы в
# плюсе» стояла перед ними и переставала смотреть на позицию ровно тогда,
# когда прибыль истончалась. Итог был: вход 0.53, пик 0.70, выход −0.07.
# 0 = выключить.
JUMP_TP_TRAIL=0.02

# НА СКОЛЬКО надо быть в плюсе, чтобы стоп вообще проснулся.
# Это и была настоящая причина «не продаёт»: раньше взвод был привязан к
# JUMP_TP_MIN_GAIN (10¢), то есть бид обязан был превысить УПЛАЧЕННЫЙ ask на
# 10¢ — это 10¢ плюс весь спред от бида на входе. Почти ни одна нога до такой
# планки не доживала, стоп молчал, и позиция падала от пика на сколько угодно
# без единой реакции. Совсем без взвода нельзя: сразу после покупки бид ниже
# ask на спред, и стоп срабатывал бы в тот же тик на каждой сделке.
JUMP_TP_TRAIL_ARM=0.02
JUMP_TP_DEADLINE_S=5.0       # «до окончания 5 секунд» — забираем прибыль
JUMP_TP_STALL_RETRACE=0.03   # откат % от пика = рост кончился
JUMP_TP_FLOW_AGAINST=-0.20   # «люди смотрят в другую сторону» (поток заявок)
JUMP_TP_STALL_S=8.0          # «проценты перестали подниматься»: пик не
                             # обновлялся столько секунд -> фиксируем
JUMP_TP_QUIET_USD=1.5        # «цена перестала резко двигаться и стоит»:
                             # движение монеты не больше этого -> фиксируем

# --- пинг / исполнение -------------------------------------------------------
# Замерь на самом VPS: python -c "from flowbot.latency import LatencyModel..."
# или просто задай ориентир. Стокгольм -> Polymarket (US-East) ~110-120мс.
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90.0
FLOW_ORDER_PROCESS_MS=45.0
FLOW_SIMULATE_LATENCY=true   # в dry-run честно ждать пинг перед филлом

# --- рантайм -----------------------------------------------------------------
RUN_DURATION_SECONDS=86400
STATUS_LOG_INTERVAL_SECONDS=0.1   # как часто печатать строку состояния
FLOW_TICK_MAX_WAIT_S=0.05         # запасной такт; обычно решение принимается
                                  # мгновенно по событию из книги
FLOW_TRADE_LOG_CSV=jump_trades.csv

# --- ЖУРНАЛ СДЕЛОК С ПРИЗНАКАМИ ----------------------------------------------
# ЛЕЖИТ ВНЕ ПАПКИ ПРОЕКТА — и это главное в нём.
# CSV выше пишется рядом с кодом, поэтому история обнулялась при КАЖДОМ
# обновлении: bot16, bot18, bot20 — и в каждой папке свой файл с нуля. Плюс в
# CSV нет признаков сигнала, и ответить «какой фильтр влияет на прибыль» по
# нему нельзя в принципе.
#
# Журнал пишет по строке JSON на каждую ЗАКРЫТУЮ ногу: Q и все её компоненты,
# скорость, ход в σ, удержание, ускорение, возраст импульса, запас, спред,
# перекос книги, стена, результат и P&L. Плюс DRY/LIVE — симуляция и реальные
# деньги в одном файле не смешиваются.
#
# Только ДОПИСЫВАЕТСЯ. Новые версии добавляют поля, не ломая старые строки.
# Разбор: python stats.py  /  python stats.py --split speed_sigmas
FLOW_STATS_ENABLED=true
FLOW_STATS_PATH=              # пусто = ~/.flowbot/trades.jsonl
