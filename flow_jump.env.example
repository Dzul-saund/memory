# =============================================================================
#  Пресет 4-й (СКАЧКОВОЙ) системы — python jump_trader.py --env-file flow_jump.env
# =============================================================================
#  Правила целиком описаны в JUMP.md. Здесь только цифры, которые крутятся.
#  ВАЖНО: этот файл в .gitignore (bot*.env / *.env) — ключ отсюда не уедет
#  в git. На VPS поставь ему chmod 600.
# =============================================================================

# --- режим -------------------------------------------------------------------
# true  = симуляция, ордера не отправляются (начинай ОТСЮДА)
# false = РЕАЛЬНЫЕ деньги; тогда обязательны PRIVATE_KEY и FUNDER ниже
DRY_RUN=true
ASSET=btc

# --- креды (только для DRY_RUN=false) ---------------------------------------
# Приватный ключ кошелька, с которого торгуем. НИКОМУ не показывай.
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- вход: что считаем «резким скачком» --------------------------------------
# КАК ловим движение:
#   swing  — от локального дна/пика. Цена ушла на $5 от экстремума — покупаем
#            в ТОТ ЖЕ ТИК, сколько бы времени движение ни заняло. Никакого
#            окна, мониторинг непрерывный. ЭТО РЕЖИМ ПО УМОЛЧАНИЮ.
#   window — старый способ: сравнить цену сейчас и JUMP_WINDOW_S назад.
#            Движение, растянувшееся дольше окна, будет пропущено.
JUMP_TRIGGER_MODE=swing
# Как далеко назад может лежать дно/пик (только для swing).
# Больше = ловим и длинные движения, но «дном» рискует стать начало раунда.
# Меньше = ближе к поведению окна. 30-90 разумно.
JUMP_SWING_LOOKBACK_S=60
JUMP_WINDOW_S=3.0            # окно режима window (в swing не используется)

JUMP_SMALL_USD=5.0           # дорогая сторона (>= сплита): хватает $5
JUMP_BIG_USD=15.0            # дешёвая сторона (< сплита): нужно $15
JUMP_PRICE_SPLIT=0.51        # граница «дорого/дёшево» по проценту
JUMP_STAKE_USDC=1.0          # первая ставка в раунде

# ПОДСТРОЙКА ПОД ЖИВОСТЬ РЫНКА.
# $5 и $15 выше верны только для той волатильности, при которой их подбирали
# (тихое воскресенье, sigma ~0.9). Когда рынок просыпается, тот же скачок
# двигает процент во столько же раз слабее — и порог поднимается автоматически:
#   sigma 0.9 -> нужен скачок $5      sigma 4.0 -> $22      sigma 6.0 -> $33
# Выключить (вернуть жёсткие $5/$15): JUMP_ADAPTIVE=false
JUMP_ADAPTIVE=true
JUMP_SIGMA_REF=0.9           # sigma, при которой калиброваны $5/$15
JUMP_SCALE_MIN=1.0           # ниже базовых порогов не опускаемся
JUMP_SCALE_MAX=8.0           # и не разгоняемся без предела

# Как далеко от таргета ещё лезем дешёвой стороной — в СИГМАХ, не в долларах.
# «Далеко» зависит от волатильности: 3 сигмы это $38 при тихом рынке
# и $255 при разогнанном. Именно поэтому фиксированные $100 не работали.
JUMP_MAX_TARGET_SIGMAS=3.0
JUMP_MAX_TARGET_DIST_USD=100 # запасной предел, пока sigma неизвестна

# ФИЛЬТР «сдвинется ли процент вообще» (в центах).
# Далеко от таргета исход раунда уже решён, и процент не реагирует на скачки
# цены — вход туда съедается спредом (~1 цент). Бот считает ожидаемый сдвиг
# по модели P = Phi((цена-таргет)/(sigma*sqrt(t))) и пропускает сигнал, если
# сдвиг меньше порога. Что важно: порог в ДОЛЛАРАХ тут не работает, потому
# что «далеко» зависит от волатильности — фильтр учитывает её сам.
# 0 = выключить. В логе видно как «чувств 4.2¢» в строке состояния.
JUMP_MIN_SHIFT_CENTS=2.0

# ЗАПАС ЦЕНЫ (в центах) — самая важная проверка из всех.
# Скачок говорит, КУДА пошла цена, но молчит о том, не заложен ли он уже
# в процент. Бот считает справедливую цену стороны по той же модели, что
# показывает P(UP) в мониторе, и сравнивает с тем, что просят в книге:
#     запас = справедливая_цена − ask
# Если справедливо 60¢, а просят 94¢ — покупать нечего, сколько бы ни
# прыгнула цена. Порог должен покрывать половину спреда (при спреде 5¢
# это 2.5¢) плюс запас на пинг. 0 = выключить.
JUMP_MIN_EDGE_CENTS=3.0
JUMP_REENTRY_COOLDOWN_S=1.0  # пауза после сделки, чтобы то же движение
                             # не открыло вторую позицию

# --- лестница добора ---------------------------------------------------------
JUMP_LADDER_ENABLED=true
JUMP_LADDER_PROFIT_USDC=0.50 # какой «+» закладываем в перекрытие минуса
JUMP_LADDER_GRACE_S=0.6      # % должен продержаться под сплитом столько
JUMP_LADDER_LOSS=0.02        # и уйти на столько ниже своей цены входа

# ЛЕСТНИЦА ТЕПЕРЬ ПРОДАЁТ провалившуюся ногу, а не держит её. Это меняет
# всё: продажа возвращает капитал, и в долге остаётся только реализованный
# убыток ноги, а не вся её стоимость.
#   держим старую: долг 1.00 -> 2.50 -> 5.50 -> 11.50 -> 23.50 (взрыв)
#   продаём:       долг 1.00 -> 0.45 -> 0.29 ->  0.24 ->  0.22 (сходится)
# Поэтому предел ступеней не нужен: 0 = БЕЗ ОГРАНИЧЕНИЙ.
JUMP_MAX_LADDER_LEGS=0       # 0 = без предела; число = жёсткий лимит
JUMP_MAX_ROUND_USDC=25.0     # потолок ВСЕХ вложений в один раунд
JUMP_MAX_LEG_PRICE=0.95      # дороже не добираем: шэров нужно слишком много

# --- фиксация прибыли (ОБЕ дорожки) ------------------------------------------
# Закрывает случай «вышли в хороший плюс, досидели до расчёта и ушли в минус».
JUMP_TP_ENABLED=true
JUMP_TP_MIN_GAIN=0.10        # фиксируем, только если в плюсе хотя бы на это
JUMP_TP_DEADLINE_S=5.0       # «до окончания 5 секунд» — забираем прибыль
JUMP_TP_STALL_RETRACE=0.03   # откат % от пика = рост кончился
JUMP_TP_FLOW_AGAINST=-0.20   # «люди смотрят в другую сторону» (поток заявок)
JUMP_TP_STALL_S=8.0          # «проценты перестали подниматься»: пик не
                             # обновлялся столько секунд -> фиксируем
JUMP_TP_QUIET_USD=1.5        # «цена перестала резко двигаться и стоит»:
                             # движение монеты не больше этого -> фиксируем

# --- пинг / исполнение -------------------------------------------------------
# Замерь на самом VPS: python -c "from flowbot.latency import LatencyModel..."
# или просто задай ориентир. Стокгольм -> Polymarket (US-East) ~110-120мс.
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90.0
FLOW_ORDER_PROCESS_MS=45.0
FLOW_SIMULATE_LATENCY=true   # в dry-run честно ждать пинг перед филлом

# --- рантайм -----------------------------------------------------------------
RUN_DURATION_SECONDS=86400
STATUS_LOG_INTERVAL_SECONDS=0.1   # как часто печатать строку состояния
FLOW_TICK_MAX_WAIT_S=0.05         # запасной такт; обычно решение принимается
                                  # мгновенно по событию из книги
FLOW_TRADE_LOG_CSV=jump_trades.csv
