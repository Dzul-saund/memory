# =============================================================================
#  Пресет 4-й (СКАЧКОВОЙ) системы — python jump_trader.py --env-file flow_jump.env
# =============================================================================
#  Правила целиком описаны в JUMP.md. Здесь только цифры, которые крутятся.
#  ВАЖНО: этот файл в .gitignore (bot*.env / *.env) — ключ отсюда не уедет
#  в git. На VPS поставь ему chmod 600.
# =============================================================================

# --- режим -------------------------------------------------------------------
# true  = симуляция, ордера не отправляются (начинай ОТСЮДА)
# false = РЕАЛЬНЫЕ деньги; тогда обязательны PRIVATE_KEY и FUNDER ниже
DRY_RUN=true
ASSET=btc

# --- креды (только для DRY_RUN=false) ---------------------------------------
# Приватный ключ кошелька, с которого торгуем. НИКОМУ не показывай.
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=3

# --- вход: что считаем «резким скачком» --------------------------------------
# КАК ловим движение:
#   swing  — от локального дна/пика. Цена ушла на $5 от экстремума — покупаем
#            в ТОТ ЖЕ ТИК, сколько бы времени движение ни заняло. Никакого
#            окна, мониторинг непрерывный. ЭТО РЕЖИМ ПО УМОЛЧАНИЮ.
#   window — старый способ: сравнить цену сейчас и JUMP_WINDOW_S назад.
#            Движение, растянувшееся дольше окна, будет пропущено.
JUMP_TRIGGER_MODE=swing
# Как далеко назад может лежать дно/пик (только для swing).
# Больше = ловим и длинные движения, но «дном» рискует стать начало раунда.
# Меньше = ближе к поведению окна. 30-90 разумно.
JUMP_SWING_LOOKBACK_S=60
JUMP_WINDOW_S=3.0            # окно режима window (в swing не используется)

JUMP_SMALL_USD=5.0           # дорогая сторона (>= сплита): хватает $5
JUMP_BIG_USD=15.0            # дешёвая сторона (< сплита): нужно $15
JUMP_PRICE_SPLIT=0.51        # граница «дорого/дёшево» по проценту
JUMP_MAX_TARGET_DIST_USD=100 # дешёвую сторону берём только так близко к таргету
JUMP_STAKE_USDC=1.0          # первая ставка в раунде
JUMP_REENTRY_COOLDOWN_S=1.0  # пауза после сделки, чтобы то же движение
                             # не открыло вторую позицию

# --- лестница добора ---------------------------------------------------------
JUMP_LADDER_ENABLED=true
JUMP_LADDER_PROFIT_USDC=0.50 # какой «+» закладываем в перекрытие минуса
JUMP_LADDER_GRACE_S=0.6      # % должен продержаться под сплитом столько
JUMP_LADDER_LOSS=0.02        # и уйти на столько ниже своей цены входа

# ПРЕДОХРАНИТЕЛИ. Лестница — это мартингейл: каждый следующий добор больше
# предыдущего. Без потолков один неудачный раунд съедает депозит.
JUMP_MAX_LADDER_LEGS=4       # сколько доборов максимум за раунд
JUMP_MAX_ROUND_USDC=25.0     # потолок ВСЕХ вложений в один раунд
JUMP_MAX_LEG_PRICE=0.95      # дороже не добираем: шэров нужно слишком много

# --- фиксация прибыли (только дешёвая дорожка) -------------------------------
JUMP_TP_ENABLED=true
JUMP_TP_MIN_GAIN=0.10        # фиксируем, только если в плюсе хотя бы на это
JUMP_TP_DEADLINE_S=5.0       # «до окончания 5 секунд» — забираем прибыль
JUMP_TP_STALL_RETRACE=0.03   # откат % от пика = рост кончился
JUMP_TP_FLOW_AGAINST=-0.20   # «люди смотрят в другую сторону» (поток заявок)

# --- пинг / исполнение -------------------------------------------------------
# Замерь на самом VPS: python -c "from flowbot.latency import LatencyModel..."
# или просто задай ориентир. Стокгольм -> Polymarket (US-East) ~110-120мс.
FLOW_PING_MS=
FLOW_ASSUMED_RTT_MS=90.0
FLOW_ORDER_PROCESS_MS=45.0
FLOW_SIMULATE_LATENCY=true   # в dry-run честно ждать пинг перед филлом

# --- рантайм -----------------------------------------------------------------
RUN_DURATION_SECONDS=86400
STATUS_LOG_INTERVAL_SECONDS=1.0
FLOW_TRADE_LOG_CSV=jump_trades.csv
